{
  "commands": {
    "clean": "xbps-remove -O",
    "install": "-Sy",
    "list": "xbps-query -l",
    "remove": "-R",
    "search": "xbps-query -Rs",
    "update": "-Su"
  },
  "detection": {
    "binary": "xbps-install",
    "distributions": [
      "void"
    ],
    "files": [
      "/usr/bin/xbps-install",
      "/usr/share/xbps.d",
      "/var/db/xbps"
    ]
  },
  "elevated": true,
  "name": "xbps",
  "repository": {
    "add": {
      "steps": [
        {
          "action": "write",
          "content": "repository={{ .URL }}\n",
          "dest": "{{ .SourcesPath }}/{{ .Name }}.conf"
        },
        {
          "action": "download",
          "condition": "{{ .HasKey }}",
          "dest": "{{ .KeyPath }}",
          "source": "{{ .KeyURL }}"
        },
        {
          "action": "command",
          "args": [
            "-S"
          ],
          "exec": "xbps-install"
        }
      ]
    },
    "paths": {
      "keys": "/var/db/xbps/keys",
      "sources": "/etc/xbps.d"
    },
    "remove": {
      "steps": [
        {
          "action": "remove",
          "path": "{{ .SourcesPath }}/{{ .Name }}.conf"
        },
        {
          "action": "remove",
          "condition": "{{ .HasKey }}",
          "path": "{{ .KeyPath }}"
        },
        {
          "action": "command",
          "args": [
            "-S"
          ],
          "exec": "xbps-install"
        }
      ]
    }
  }
}
