{
  "commands": {
    "clean": "",
    "install": "install",
    "list": "list --user --enabled",
    "remove": "uninstall",
    "search": "search",
    "update": "update"
  },
  "detection": {
    "binary": "gnome-extensions",
    "distributions": [
      "linux"
    ],
    "files": [
      "/usr/bin/gnome-extensions",
      "/usr/bin/gext",
      "~/.local/share/gnome-shell/extensions"
    ]
  },
  "elevated": false,
  "name": "gnome-extensions",
  "repository": {
    "add": {
      "steps": [
        {
          "action": "command",
          "args": [
            "install",
            "{{ .Path }}"
          ],
          "condition": "{{ .IsLocalFile }}",
          "exec": "gnome-extensions"
        },
        {
          "action": "command",
          "args": [
            "install",
            "--force",
            "{{ .ExtensionID }}"
          ],
          "condition": "{{ not .IsLocalFile }}",
          "exec": "gnome-extensions"
        },
        {
          "action": "command",
          "args": [
            "enable",
            "{{ .UUID }}"
          ],
          "exec": "gnome-extensions"
        }
      ]
    },
    "remove": {
      "steps": [
        {
          "action": "command",
          "args": [
            "disable",
            "{{ .UUID }}"
          ],
          "exec": "gnome-extensions"
        },
        {
          "action": "command",
          "args": [
            "uninstall",
            "{{ .UUID }}"
          ],
          "exec": "gnome-extensions"
        },
        {
          "action": "command",
          "args": [
            "reset",
            "{{ .UUID }}"
          ],
          "condition": "{{ .ResetSettings }}",
          "exec": "gnome-extensions"
        }
      ]
    }
  }
}
