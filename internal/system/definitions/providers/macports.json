{
  "commands": {
    "clean": "clean --all all",
    "install": "install",
    "list": "installed",
    "remove": "uninstall",
    "search": "search",
    "update": "selfupdate"
  },
  "corePackages": {
    "build-essentials": [
      "make",
      "cmake",
      "pkgconfig",
      "freetype",
      "fontconfig"
    ],
    "openssl": [
      "openssl",
      "openssl-devel"
    ]
  },
  "detection": {
    "binary": "port",
    "distributions": [
      "darwin"
    ],
    "files": [
      "/opt/local/bin/port",
      "/opt/local/etc/macports"
    ]
  },
  "elevated": true,
  "install": {
    "steps": [
      {
        "action": "download",
        "dest": "{{ .TempDir }}/MacPorts-2.8.1-13-Ventura.pkg",
        "sha256": "577512628a4b9237b3eccd0e18af28e06855f5d55bd71957c37a9c7c362de5f3",
        "source": "https://github.com/macports/macports-base/releases/download/v2.8.1/MacPorts-2.8.1-13-Ventura.pkg"
      },
      {
        "action": "command",
        "args": [
          "-pkg",
          "{{ .TempDir }}/MacPorts-2.8.1-13-Ventura.pkg",
          "-target",
          "/"
        ],
        "exec": "installer"
      },
      {
        "action": "command",
        "args": [
          "{{ .TempDir }}/MacPorts-2.8.1-13-Ventura.pkg"
        ],
        "exec": "rm"
      },
      {
        "action": "command",
        "args": [
          "selfupdate"
        ],
        "exec": "port"
      }
    ]
  },
  "name": "macports",
  "remove": {
    "steps": [
      {
        "action": "command",
        "args": [
          "-f",
          "uninstall",
          "installed"
        ],
        "exec": "port"
      },
      {
        "action": "command",
        "args": [
          "-rf",
          "/opt/local",
          "/Applications/DarwinPorts",
          "/Applications/MacPorts",
          "/Library/LaunchDaemons/org.macports.*",
          "/Library/Receipts/DarwinPorts*.pkg",
          "/Library/Receipts/MacPorts*.pkg",
          "/Library/StartupItems/DarwinPortsStartup",
          "/Library/Tcl/darwinports1.0",
          "/Library/Tcl/macports1.0",
          "~/.macports"
        ],
        "exec": "rm"
      }
    ]
  },
  "repository": {
    "add": {
      "steps": [
        {
          "action": "command",
          "args": [
            "sync"
          ],
          "exec": "port"
        },
        {
          "action": "append",
          "content": "{{ .URL }}",
          "path": "{{ .SourcesPath }}"
        },
        {
          "action": "command",
          "args": [
            "selfupdate"
          ],
          "exec": "port"
        }
      ]
    },
    "paths": {
      "sources": "/opt/local/etc/macports/sources.conf"
    },
    "remove": {
      "steps": [
        {
          "action": "remove_line",
          "match": "{{ .URL }}",
          "path": "{{ .SourcesPath }}"
        },
        {
          "action": "command",
          "args": [
            "selfupdate"
          ],
          "exec": "port"
        }
      ]
    }
  }
}
