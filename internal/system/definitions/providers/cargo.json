{
  "commands": {
    "clean": "cache --autoclean",
    "install": "install",
    "list": "install --list",
    "remove": "uninstall",
    "search": "search",
    "update": "install-update --all"
  },
  "corePackages": {
    "build-essentials": [],
    "openssl": []
  },
  "detection": {
    "binary": "cargo",
    "distributions": [
      "linux",
      "darwin",
      "windows"
    ],
    "files": [
      "~/.cargo/bin/cargo",
      "~/.rustup"
    ]
  },
  "elevated": false,
  "install": {
    "steps": [
      {
        "action": "command",
        "args": [
          "--proto",
          "=https",
          "--tlsv1.2",
          "-sSf",
          "https://sh.rustup.rs",
          "-o",
          "{{ .TempDir }}/rustup-init.sh"
        ],
        "exec": "curl"
      },
      {
        "action": "command",
        "args": [
          "{{ .TempDir }}/rustup-init.sh",
          "-y"
        ],
        "exec": "sh"
      },
      {
        "action": "command",
        "args": [
          "install",
          "cargo-update",
          "--features",
          "vendored-openssl"
        ],
        "exec": "cargo"
      }
    ]
  },
  "name": "cargo",
  "remove": {
    "steps": [
      {
        "action": "command",
        "args": [
          "self",
          "uninstall",
          "-y"
        ],
        "exec": "rustup"
      }
    ]
  },
  "repository": {
    "add": {
      "steps": [
        {
          "action": "command",
          "args": [
            "update"
          ],
          "exec": "cargo"
        },
        {
          "action": "write",
          "condition": "{{ .IsCustomRegistry }}",
          "content": "[registries.{{ .Name }}]\nindex = \"{{ .URL }}\"\n",
          "dest": "{{ .ConfigPath }}"
        },
        {
          "action": "command",
          "args": [
            "login",
            "--registry",
            "{{ .Name }}",
            "{{ .Token }}"
          ],
          "condition": "{{ .HasToken }}",
          "exec": "cargo"
        }
      ]
    },
    "paths": {
      "config": "~/.cargo/config.toml"
    },
    "remove": {
      "steps": [
        {
          "action": "command",
          "args": [
            "logout",
            "--registry",
            "{{ .Name }}"
          ],
          "condition": "{{ .HasToken }}",
          "exec": "cargo"
        },
        {
          "action": "remove_section",
          "condition": "{{ .IsCustomRegistry }}",
          "path": "{{ .ConfigPath }}",
          "section": "registries.{{ .Name }}"
        }
      ]
    }
  }
}
