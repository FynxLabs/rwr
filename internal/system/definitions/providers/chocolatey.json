{
  "commands": {
    "clean": "cache delete",
    "install": "install -y",
    "list": "list --local-only",
    "remove": "uninstall -y",
    "search": "search",
    "update": "upgrade -y all"
  },
  "corePackages": {
    "build-essentials": [
      "make",
      "cmake",
      "freetype",
      "fontconfig"
    ],
    "openssl": [
      "openssl"
    ]
  },
  "detection": {
    "binary": "choco",
    "distributions": [
      "windows"
    ],
    "files": [
      "%ProgramData%\\chocolatey\\bin\\choco.exe"
    ]
  },
  "elevated": true,
  "install": {
    "steps": [
      {
        "action": "command",
        "args": [
          "-Command",
          "Set-ExecutionPolicy Bypass -Scope Process -Force; [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072; iex ((New-Object System.Net.WebClient).DownloadString('https://chocolatey.org/install.ps1'))"
        ],
        "exec": "powershell"
      }
    ]
  },
  "name": "chocolatey",
  "remove": {
    "steps": [
      {
        "action": "command",
        "args": [
          "-Command",
          "choco uninstall chocolatey -y"
        ],
        "exec": "powershell"
      }
    ]
  },
  "repository": {
    "add": {
      "steps": [
        {
          "action": "command",
          "args": [
            "source",
            "add",
            "--name={{ .Name }}",
            "--source={{ .URL }}"
          ],
          "exec": "choco"
        },
        {
          "action": "command",
          "args": [
            "source",
            "add",
            "--name={{ .Name }}",
            "--source={{ .URL }}",
            "--user={{ .Username }}",
            "--password={{ .Password }}"
          ],
          "condition": "{{ .HasAuthentication }}",
          "exec": "choco"
        }
      ]
    },
    "paths": {
      "sources": "%ProgramData%\\chocolatey\\config"
    },
    "remove": {
      "steps": [
        {
          "action": "command",
          "args": [
            "source",
            "remove",
            "--name={{ .Name }}"
          ],
          "exec": "choco"
        }
      ]
    }
  }
}
