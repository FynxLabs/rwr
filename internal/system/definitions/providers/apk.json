{
  "commands": {
    "clean": "cache clean",
    "install": "add",
    "list": "info",
    "remove": "del",
    "search": "search",
    "update": "update"
  },
  "corePackages": {
    "build-essentials": [
      "build-base",
      "cmake",
      "pkgconfig",
      "freetype-dev",
      "fontconfig-dev",
      "libxcb-dev",
      "libxkbcommon-dev",
      "python3"
    ],
    "openssl": [
      "openssl",
      "openssl-dev"
    ]
  },
  "detection": {
    "binary": "apk",
    "distributions": [
      "alpine"
    ],
    "files": [
      "/sbin/apk",
      "/etc/apk",
      "/var/cache/apk"
    ]
  },
  "elevated": true,
  "install": {
    "steps": [
      {
        "action": "command",
        "args": [
          "update"
        ],
        "exec": "apk"
      },
      {
        "action": "command",
        "args": [
          "upgrade"
        ],
        "exec": "apk"
      }
    ]
  },
  "name": "apk",
  "remove": {
    "steps": [
      {
        "action": "command",
        "args": [
          "cache",
          "clean"
        ],
        "exec": "apk"
      }
    ]
  },
  "repository": {
    "add": {
      "steps": [
        {
          "action": "download",
          "condition": "{{ .HasKey }}",
          "dest": "{{ .KeyPath }}",
          "source": "{{ .KeyURL }}"
        },
        {
          "action": "append",
          "content": "{{ .URL }}",
          "path": "{{ .SourcesPath }}"
        },
        {
          "action": "command",
          "args": [
            "update"
          ],
          "exec": "apk"
        }
      ]
    },
    "paths": {
      "keys": "/etc/apk/keys",
      "sources": "/etc/apk/repositories"
    },
    "remove": {
      "steps": [
        {
          "action": "remove_line",
          "match": "{{ .URL }}",
          "path": "{{ .SourcesPath }}"
        },
        {
          "action": "remove",
          "condition": "{{ .HasKey }}",
          "path": "{{ .KeyPath }}"
        },
        {
          "action": "command",
          "args": [
            "update"
          ],
          "exec": "apk"
        }
      ]
    }
  }
}
