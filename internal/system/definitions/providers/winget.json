{
  "commands": {
    "clean": "source reset",
    "install": "install --silent",
    "list": "list",
    "remove": "uninstall",
    "search": "search",
    "update": "upgrade --all"
  },
  "corePackages": {
    "build-essentials": [
      "GnuWin32.Make",
      "Kitware.CMake",
      "FreeType.FreeType",
      "FontConfig.FontConfig"
    ],
    "openssl": [
      "OpenSSL.OpenSSL"
    ]
  },
  "detection": {
    "binary": "winget",
    "distributions": [
      "windows"
    ],
    "files": [
      "%LOCALAPPDATA%\\Microsoft\\WindowsApps\\winget.exe"
    ]
  },
  "elevated": false,
  "install": {
    "steps": [
      {
        "action": "command",
        "args": [
          "-Command",
          "Invoke-WebRequest -Uri https://github.com/microsoft/winget-cli/releases/download/v1.5.9371.0/Microsoft.DesktopAppInstaller_8wekyb3d8bbwe.appxbundle -OutFile winget.appxbundle"
        ],
        "exec": "powershell"
      },
      {
        "action": "command",
        "args": [
          "-Command",
          "Add-AppxPackage -Path winget.appxbundle"
        ],
        "exec": "powershell"
      },
      {
        "action": "command",
        "args": [
          "-Command",
          "Remove-Item winget.appxbundle"
        ],
        "exec": "powershell"
      }
    ]
  },
  "name": "winget",
  "remove": {
    "steps": [
      {
        "action": "command",
        "args": [
          "-Command",
          "Get-AppxPackage Microsoft.DesktopAppInstaller | Remove-AppxPackage"
        ],
        "exec": "powershell"
      }
    ]
  },
  "repository": {
    "add": {
      "steps": [
        {
          "action": "command",
          "args": [
            "source",
            "add",
            "-n",
            "{{ .Name }}",
            "--url",
            "{{ .URL }}"
          ],
          "exec": "winget"
        }
      ]
    },
    "paths": {
      "sources": "%LOCALAPPDATA%\\Microsoft\\WindowsApps\\Sources"
    },
    "remove": {
      "steps": [
        {
          "action": "command",
          "args": [
            "source",
            "remove",
            "-n",
            "{{ .Name }}"
          ],
          "exec": "winget"
        }
      ]
    }
  }
}
