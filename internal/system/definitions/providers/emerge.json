{
  "commands": {
    "clean": "--depclean",
    "install": "-qv",
    "list": "qlist -I",
    "listExplicit": "cat /var/lib/portage/world",
    "remove": "-C",
    "search": "-s",
    "update": "-uDN @world"
  },
  "detection": {
    "binary": "emerge",
    "distributions": [
      "gentoo"
    ],
    "files": [
      "/usr/bin/emerge",
      "/etc/portage",
      "/var/db/repos/gentoo"
    ]
  },
  "elevated": true,
  "name": "emerge",
  "repository": {
    "add": {
      "steps": [
        {
          "action": "write",
          "content": "[{{ .Name }}]\nlocation = {{ .OverlayPath }}\nsync-type = {{ .SyncType }}\nsync-uri = {{ .URL }}\nauto-sync = yes\n",
          "dest": "{{ .SourcesPath }}/{{ .Name }}.conf"
        },
        {
          "action": "command",
          "args": [
            "sync",
            "-r",
            "{{ .Name }}"
          ],
          "exec": "emaint"
        },
        {
          "action": "command",
          "args": [
            "--sync"
          ],
          "condition": "{{ .IsMainRepo }}",
          "exec": "emerge"
        }
      ]
    },
    "paths": {
      "sources": "/etc/portage/repos.conf"
    },
    "remove": {
      "steps": [
        {
          "action": "remove",
          "path": "{{ .SourcesPath }}/{{ .Name }}.conf"
        },
        {
          "action": "command",
          "args": [
            "-rf",
            "{{ .OverlayPath }}"
          ],
          "exec": "rm"
        }
      ]
    }
  }
}
