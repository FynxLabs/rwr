{
  "commands": {
    "clean": "-Sc --noconfirm",
    "install": "-Sy --noconfirm",
    "list": "-Q",
    "remove": "-R --noconfirm",
    "search": "-Ss",
    "update": "-Syu --noconfirm"
  },
  "corePackages": {
    "build-essentials": [
      "base-devel",
      "cmake",
      "freetype2",
      "fontconfig",
      "pkg-config",
      "libxcb",
      "libxkbcommon",
      "python"
    ],
    "openssl": [
      "openssl"
    ]
  },
  "detection": {
    "binary": "pacman",
    "distributions": [
      "arch",
      "cachyos",
      "linux/cachyos",
      "manjaro",
      "linux/acreetion"
    ],
    "files": [
      "/etc/pacman.conf",
      "/var/lib/pacman"
    ]
  },
  "elevated": true,
  "name": "pacman",
  "repository": {
    "add": {
      "steps": [
        {
          "action": "append",
          "content": "[{{ .Name }}]\nServer = {{ .URL }}\n",
          "path": "{{ .ConfigPath }}"
        },
        {
          "action": "command",
          "args": [
            "--recv-keys",
            "{{ .KeyID }}"
          ],
          "condition": "{{ .HasKey }}",
          "exec": "pacman-key"
        },
        {
          "action": "command",
          "args": [
            "--lsign-key",
            "{{ .KeyID }}"
          ],
          "condition": "{{ .HasKey }}",
          "exec": "pacman-key"
        }
      ]
    },
    "paths": {
      "config": "/etc/pacman.conf",
      "keys": "/etc/pacman.d/gnupg",
      "sources": "/etc/pacman.d"
    },
    "remove": {
      "steps": [
        {
          "action": "command",
          "args": [
            "--delete",
            "{{ .KeyID }}"
          ],
          "condition": "{{ .HasKey }}",
          "exec": "pacman-key"
        },
        {
          "action": "remove_section",
          "path": "{{ .ConfigPath }}",
          "section": "{{ .Name }}"
        }
      ]
    }
  }
}
