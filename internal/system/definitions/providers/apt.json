{
  "commands": {
    "clean": "clean",
    "install": "install -y",
    "list": "dpkg --get-selections",
    "listExplicit": "apt-mark showmanual",
    "remove": "remove -y",
    "search": "search",
    "update": "update"
  },
  "corePackages": {
    "build-essentials": [
      "build-essential",
      "cmake",
      "pkg-config",
      "libfreetype6-dev",
      "libfontconfig1-dev",
      "libxcb-xfixes0-dev",
      "libxkbcommon-dev",
      "python3"
    ],
    "openssl": [
      "openssl",
      "libssl-dev"
    ]
  },
  "detection": {
    "binary": "apt",
    "distributions": [
      "debian",
      "ubuntu"
    ],
    "files": [
      "/etc/apt"
    ]
  },
  "elevated": true,
  "name": "apt",
  "repository": {
    "add": {
      "steps": [
        {
          "action": "download",
          "dest": "{{ .TempKeyPath }}",
          "sha256": "{{ .KeySha256 }}",
          "source": "{{ .KeyURL }}"
        },
        {
          "action": "command",
          "args": [
            "--yes",
            "--dearmor",
            "-o",
            "{{ .KeyPath }}",
            "{{ .TempKeyPath }}"
          ],
          "exec": "gpg"
        },
        {
          "action": "write",
          "content": "deb [arch={{ .Arch }} signed-by={{ .KeyPath }}] {{ .URL }} {{ .Channel }} {{ .Component }}",
          "dest": "{{ .SourcesPath }}/{{ .Name }}.list"
        }
      ]
    },
    "paths": {
      "keys": "/usr/share/keyrings",
      "sources": "/etc/apt/sources.list.d"
    },
    "remove": {
      "steps": [
        {
          "action": "remove",
          "path": "{{ .SourcesPath }}/{{ .Name }}.list"
        },
        {
          "action": "remove",
          "path": "{{ .KeyPath }}"
        }
      ]
    }
  }
}
